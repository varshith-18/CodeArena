@import "tailwindcss";

:root {
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
    "Segoe UI", sans-serif;
  color: #edf0f7;
  background: #0b0d12;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  font-optical-sizing: auto;
  font-weight: 400;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  background: #0b0d12;
}

button,
input {
  font: inherit;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  color: inherit;
  cursor: pointer;
}

.app-shell {
  min-height: 100vh;
}

.sidebar {
  width: 252px;
  position: fixed;
  inset: 0 auto 0 0;
  z-index: 20;
  display: flex;
  flex-direction: column;
  padding: 25px 17px 16px;
  background: #101219;
  border-right: 1px solid #222530;
}

.brand {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 0 5px 32px;
}

.brand-icon {
  display: grid;
  place-items: center;
  width: 43px;
  height: 43px;
  color: #b8a3ff;
  background: #29213f;
  border: 1px solid #453366;
  border-radius: 13px;
}

.brand h2 {
  margin: 0;
  font-size: 18px;
  font-weight: 750;
  letter-spacing: -0.5px;
}

.brand p {
  margin: 4px 0 0;
  color: #82879a;
  font-size: 9px;
  letter-spacing: 1.5px;
  font-weight: 700;
}

.nav-heading {
  padding: 0 12px;
  margin: 0 0 12px;
  color: #777d8e;
  font-size: 10px;
  letter-spacing: 1.3px;
  font-weight: 750;
}

.navigation {
  display: grid;
  gap: 6px;
}

.nav-link {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px;
  color: #a0a5b5;
  font-size: 13px;
  font-weight: 550;
  border-radius: 9px;
  transition: background 150ms, color 150ms;
}

.nav-link:hover {
  color: #f3f1ff;
  background: #1b1d29;
}

.nav-link-active {
  color: #c9baff;
  background: #29213f;
  box-shadow: inset 2px 0 #a58aff;
}

.sidebar-bottom {
  margin-top: auto;
}

.upgrade-card {
  padding: 17px 14px;
  margin-bottom: 18px;
  border: 1px solid #343047;
  border-radius: 12px;
  background: linear-gradient(145deg, #211d31, #171822);
}

.upgrade-icon {
  display: grid;
  place-items: center;
  width: 35px;
  height: 35px;
  margin-bottom: 13px;
  color: #c2adff;
  background: #34284d;
  border-radius: 10px;
}

.upgrade-card h3 {
  margin: 0;
  font-size: 13px;
}

.upgrade-card p {
  margin: 8px 0 14px;
  color: #999caf;
  font-size: 11px;
  line-height: 1.65;
}

.upgrade-card a {
  color: #c6b4ff;
  font-size: 11px;
  font-weight: 700;
}

.sidebar-footer {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 16px 5px 0;
  margin-top: 12px;
  border-top: 1px solid #272a35;
}

.avatar,
.topbar-avatar {
  display: grid;
  place-items: center;
  flex-shrink: 0;
  color: white;
  font-weight: 700;
  background: linear-gradient(145deg, #7e65d9, #493d85);
  border-radius: 50%;
}

.avatar {
  width: 35px;
  height: 35px;
  font-size: 13px;
}

.user-info {
  display: grid;
  gap: 4px;
}

.user-info strong {
  font-size: 12px;
  font-weight: 650;
}

.user-info span {
  color: #858a9b;
  font-size: 10px;
}

.main-area {
  min-height: 100vh;
  margin-left: 252px;
}

.topbar {
  height: 72px;
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 0 35px;
  background: rgba(11, 13, 18, 0.92);
  border-bottom: 1px solid #222530;
  backdrop-filter: blur(15px);
}

.breadcrumb {
  display: flex;
  align-items: center;
  gap: 12px;
  color: #818699;
  font-size: 12px;
}

.breadcrumb-divider {
  color: #4b5060;
}

.breadcrumb strong {
  color: #e3e5ed;
  font-weight: 600;
}

.topbar-actions {
  display: flex;
  align-items: center;
  gap: 17px;
}

.search-button {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 215px;
  padding: 9px 11px;
  color: #8d92a3;
  background: #151720;
  border: 1px solid #292c38;
  border-radius: 8px;
  font-size: 11px;
  text-align: left;
}

.search-button kbd {
  margin-left: auto;
  padding: 2px 5px;
  color: #85899a;
  background: #222530;
  border-radius: 4px;
}

.streak-badge {
  display: flex;
  align-items: center;
  gap: 6px;
  color: #ffbc73;
  font-size: 11px;
  white-space: nowrap;
}

.icon-button,
.mobile-menu,
.mobile-close {
  display: grid;
  place-items: center;
  padding: 7px;
  color: #9ca1b1;
  background: transparent;
  border: 0;
  border-radius: 8px;
}

.icon-button:hover,
.mobile-menu:hover {
  background: #1a1c26;
  color: white;
}

.topbar-avatar {
  width: 32px;
  height: 32px;
  font-size: 12px;
}

.mobile-menu,
.mobile-close,
.sidebar-overlay {
  display: none;
}

.page-content {
  max-width: 1500px;
  padding: 35px;
  margin: 0 auto;
}

.welcome-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22px;
  margin-bottom: 29px;
}

.eyebrow {
  display: flex;
  align-items: center;
  gap: 7px;
  margin-bottom: 13px;
  color: #b3a0ff;
  font-size: 10px;
  font-weight: 750;
  letter-spacing: 1.4px;
}

.welcome-section h1 {
  margin: 0;
  font-size: clamp(23px, 2.5vw, 31px);
  line-height: 1.3;
  font-weight: 750;
  letter-spacing: -1px;
}

.welcome-section h1 span {
  font-size: 25px;
}

.welcome-section p {
  margin: 10px 0 0;
  color: #9398aa;
  font-size: 12px;
  line-height: 1.6;
}

.primary-button,
.secondary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 12px 15px;
  border-radius: 8px;
  font-size: 12px;
  font-weight: 650;
  white-space: nowrap;
  transition: transform 150ms, background 150ms;
}

.primary-button {
  color: #fff;
  background: #8065e9;
  box-shadow: 0 5px 18px #8065e91b;
}

.primary-button:hover {
  background: #927af3;
  transform: translateY(-1px);
}

.secondary-button {
  padding: 9px 14px;
  color: #e2e8f0;
  background: #202939;
  border: 1px solid #39445a;
  cursor: pointer;
}

.secondary-button:hover {
  background: #29213f;
  border-color: #818cf8;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 15px;
  margin-bottom: 24px;
}

.stat-card,
.panel {
  background: #11131b;
  border: 1px solid #252834;
  border-radius: 12px;
}

.stat-card {
  min-width: 0;
  padding: 19px;
}

.stat-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.stat-title {
  color: #a1a6b6;
  font-size: 11px;
  font-weight: 550;
}

.stat-icon {
  display: grid;
  place-items: center;
  width: 37px;
  height: 37px;
  flex-shrink: 0;
  border-radius: 10px;
}

.stat-icon-green {
  color: #70d9a1;
  background: #193328;
}

.stat-icon-blue {
  color: #79b7ff;
  background: #1c2b42;
}

.stat-icon-purple {
  color: #c1a7ff;
  background: #2b2242;
}

.stat-icon-orange {
  color: #ffbd7a;
  background: #3a2a20;
}

.stat-value {
  margin-top: 18px;
  font-size: 27px;
  font-weight: 750;
  letter-spacing: -0.8px;
}

.stat-description {
  margin: 7px 0 0;
  color: #7f8597;
  font-size: 10px;
  line-height: 1.5;
}

.dashboard-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.55fr) minmax(260px, 0.95fr);
  align-items: start;
  gap: 20px;
}

.panel {
  padding: 22px;
  min-width: 0;
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 20px;
}

.panel-header h2,
.daily-panel h2 {
  margin: 0;
  font-size: 14px;
  font-weight: 700;
}

.panel-header p {
  margin: 7px 0 0;
  color: #858b9e;
  font-size: 11px;
}

.text-link {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  color: #b6a3ff;
  font-size: 11px;
  font-weight: 650;
  white-space: nowrap;
}

.text-link:hover {
  color: #d3c8ff;
}

.problem-list {
  margin-bottom: 18px;
}

.problem-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 16px 0;
  border-bottom: 1px solid #252834;
}

.problem-row:first-child {
  padding-top: 3px;
}

.problem-row:last-child {
  border-bottom: 0;
}

.problem-status {
  display: grid;
  place-items: center;
  flex-shrink: 0;
  color: #666c7d;
}

.problem-main {
  flex: 1;
  min-width: 0;
}

.problem-main > strong {
  display: block;
  overflow: hidden;
  color: #e5e7ef;
  font-size: 12px;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.problem-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 9px;
  margin-top: 8px;
  color: #858b9e;
  font-size: 10px;
}

.problem-arrow {
  flex-shrink: 0;
  color: #666c7d;
  transition: color 150ms, transform 150ms;
}

.problem-row:hover .problem-arrow {
  color: #c1adff;
  transform: translate(2px, -2px);
}

.problem-row:hover .problem-main > strong {
  color: #c8b8ff;
}

.full-width {
  width: 100%;
}

.right-column {
  display: grid;
  gap: 20px;
}

.muted-icon {
  color: #8e94a7;
}

.progress-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.muted-label {
  color: #969bad;
  font-size: 10px;
}

.progress-number {
  margin-top: 8px;
  font-size: 25px;
  font-weight: 750;
}

.progress-number span {
  color: #82879a;
  font-size: 10px;
  font-weight: 450;
}

.progress-percent {
  color: #72dba5;
  font-size: 12px;
  font-weight: 700;
}

.progress-track {
  height: 6px;
  overflow: hidden;
  margin-top: 16px;
  background: #272a35;
  border-radius: 99px;
}

.progress-fill {
  width: 0%;
  height: 100%;
  background: #8b71ed;
  border-radius: inherit;
}

.activity-chart {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  height: 83px;
  margin-top: 24px;
}

.activity-day {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: end;
  gap: 9px;
  color: #81879a;
  font-size: 10px;
}

.activity-bar {
  display: flex;
  align-items: end;
  justify-content: center;
  width: 100%;
  max-width: 27px;
  height: 62px;
  overflow: hidden;
  background: #1c1f29;
  border-radius: 5px;
}

.activity-bar span {
  display: block;
  width: 100%;
  height: 35%;
  background: #5e4b9e;
  border-radius: 5px;
}

.activity-level-2 span {
  height: 65%;
  background: #8065d2;
}

.activity-level-3 span {
  height: 90%;
  background: #a58aff;
}

.daily-panel {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  padding: 20px;
  background: linear-gradient(145deg, #191627, #11131b);
  border-color: #37304b;
}

.daily-icon {
  display: grid;
  place-items: center;
  width: 40px;
  height: 40px;
  flex-shrink: 0;
  color: #c3b1ff;
  background: #302544;
  border-radius: 10px;
}

.daily-panel h2 {
  margin-top: 2px;
}

.daily-panel p {
  margin: 9px 0 13px;
  color: #9b9eb0;
  font-size: 11px;
  line-height: 1.7;
}

.dashboard-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 35px;
  padding: 18px 0 4px;
  color: #707689;
  border-top: 1px solid #222530;
  font-size: 10px;
}

.dashboard-footer > span:last-child {
  display: flex;
  align-items: center;
  gap: 6px;
}

.footer-dot {
  padding: 0 5px;
  color: #a58aff;
}

@media (min-width: 1500px) {
  .page-content {
    padding: 42px 45px;
  }

  .stats-grid {
    gap: 20px;
  }
}

@media (max-width: 1200px) {
  .page-content {
    padding: 28px;
  }

  .stats-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .dashboard-grid {
    grid-template-columns: minmax(0, 1.2fr) minmax(250px, 0.8fr);
  }

  .topbar {
    padding: 0 25px;
  }
}

@media (max-width: 900px) {
  .sidebar {
    transform: translateX(-100%);
    transition: transform 200ms ease;
  }

  .sidebar.sidebar-open {
    transform: translateX(0);
  }

  .sidebar-overlay {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 15;
    background: #0009;
    border: 0;
  }

  .mobile-close {
    display: grid;
    margin-left: auto;
  }

  .main-area {
    margin-left: 0;
  }

  .mobile-menu {
    display: grid;
  }

  .topbar {
    justify-content: flex-start;
    gap: 12px;
  }

  .breadcrumb {
    flex: 1;
  }

  .dashboard-grid {
    grid-template-columns: 1fr;
  }

  .right-column {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 600px) {
  .topbar {
    height: 62px;
    gap: 8px;
    padding: 0 14px;
  }

  .breadcrumb {
    font-size: 10px;
    gap: 7px;
  }

  .topbar-actions {
    gap: 9px;
  }

  .search-button {
    width: 35px;
    height: 35px;
    justify-content: center;
    padding: 0;
  }

  .search-button span,
  .search-button kbd,
  .streak-badge {
    display: none;
  }

  .page-content {
    padding: 24px 15px;
  }

  .welcome-section {
    align-items: flex-start;
    flex-direction: column;
    margin-bottom: 24px;
  }

  .welcome-section h1 {
    font-size: 25px;
  }

  .stats-grid {
    gap: 10px;
  }

  .stat-card {
    padding: 14px;
  }

  .stat-title {
    font-size: 10px;
  }

  .stat-icon {
    width: 32px;
    height: 32px;
  }

  .stat-value {
    font-size: 24px;
  }

  .panel {
    padding: 17px;
  }

  .right-column {
    grid-template-columns: 1fr;
  }

  .dashboard-footer {
    align-items: flex-start;
    flex-direction: column;
  }
}

/* ========================================
   Problems page
======================================== */

.problems-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 25px;
}

.problems-heading h1 {
  margin: 0;
  font-size: 30px;
  font-weight: 750;
  letter-spacing: -0.8px;
}

.problems-heading p {
  margin: 9px 0 0;
  color: #9398aa;
  font-size: 12px;
  line-height: 1.7;
}

.problems-total {
  display: grid;
  gap: 5px;
  padding: 13px 17px;
  background: #151720;
  border: 1px solid #292c38;
  border-radius: 10px;
  text-align: right;
}

.problems-total strong {
  font-size: 22px;
}

.problems-total span {
  color: #858b9e;
  font-size: 10px;
}

/* Difficulty statistics */

.problem-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
  margin-bottom: 24px;
}

.problem-stat {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
  padding: 17px 20px;
  border: 1px solid #293244;
  border-radius: 12px;
  background: #111722;
  color: #aab4c5;
  font-size: 13px;
}

.problem-stat strong {
  margin-left: auto;
  color: #f8fafc;
  font-size: 21px;
}

.difficulty-dot {
  width: 9px;
  height: 9px;
  flex-shrink: 0;
  border-radius: 50%;
}

.dot-easy {
  background: #4ade80;
}

.dot-medium {
  background: #fbbf24;
}

.dot-hard {
  background: #fb7185;
}

/* Main panel */

.problems-panel {
  min-width: 0;
  overflow: hidden;
  border: 1px solid #293244;
  border-radius: 14px;
  background: #111722;
}

.problems-toolbar {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 20px 22px 14px;
}

.problems-search {
  display: flex;
  align-items: center;
  gap: 10px;
  flex: 1;
  min-width: 0;
  padding: 11px 13px;
  border: 1px solid #30394b;
  border-radius: 9px;
  background: #171e2b;
  color: #94a3b8;
  transition: border-color 0.2s ease;
}

.problems-search:focus-within {
  border-color: #818cf8;
}

.problems-search input {
  width: 100%;
  min-width: 0;
  padding: 0;
  border: 0;
  outline: none;
  background: transparent;
  color: #f1f5f9;
  font: inherit;
  font-size: 13px;
}

.problems-search input::placeholder {
  color: #748197;
}

.clear-search {
  display: grid;
  place-items: center;
  padding: 3px;
  border: 0;
  background: transparent;
  color: #94a3b8;
  cursor: pointer;
}

.clear-search:hover {
  color: white;
}

.filter-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 11px 15px;
  border: 1px solid #30394b;
  border-radius: 9px;
  background: #171e2b;
  color: #cbd5e1;
  font-size: 13px;
  cursor: pointer;
  transition: 0.2s ease;
}

.filter-button:hover,
.filter-button-active {
  border-color: #818cf8;
  background: #222641;
  color: #c7d2fe;
}

/* Difficulty filter chips */

.difficulty-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  padding: 4px 22px 18px;
}

.filter-chip {
  padding: 7px 14px;
  border: 1px solid #30394b;
  border-radius: 7px;
  background: #171e2b;
  color: #aab4c5;
  font-size: 12px;
  cursor: pointer;
  transition: 0.2s ease;
}

.filter-chip:hover {
  border-color: #64748b;
  color: #f8fafc;
}

.filter-chip-active {
  border-color: #6366f1;
  background: #29274d;
  color: #c7d2fe;
}

/* Advanced topic filters */

.advanced-filters {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
  padding: 16px 22px;
  border-top: 1px solid #293244;
  border-bottom: 1px solid #293244;
  background: #151b28;
}

.advanced-filters label {
  color: #cbd5e1;
  font-size: 13px;
}

.advanced-filters select {
  min-width: 170px;
  padding: 9px 12px;
  border: 1px solid #30394b;
  border-radius: 8px;
  outline: none;
  background: #111722;
  color: #e2e8f0;
  font-size: 13px;
}

.advanced-filters select:focus {
  border-color: #818cf8;
}

.advanced-filters option {
  background: #191b25;
}

.reset-filters {
  padding: 7px 10px;
  border: 0;
  border-radius: 6px;
  background: transparent;
  color: #a5b4fc;
  font-size: 12px;
  cursor: pointer;
}

.reset-filters:hover {
  background: #242742;
  color: #c7d2fe;
}

/* Table summary */

.table-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 14px 22px;
  border-top: 1px solid #293244;
  color: #94a3b8;
  font-size: 12px;
}

.table-summary strong {
  color: #e2e8f0;
}

/* Problems table */

.problems-table-wrap {
  width: 100%;
  overflow-x: auto;
}

.problems-table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
  white-space: nowrap;
}

.problems-table thead {
  background: #171e2b;
}

.problems-table th {
  padding: 14px 18px;
  background: #151720;
  border-top: 1px solid #293244;
  border-bottom: 1px solid #293244;
  color: #8491a6;
  font-size: 10px;
  font-weight: 750;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.problems-table th:first-child {
  border-radius: 7px 0 0 0;
}

.problems-table th:last-child {
  border-radius: 0 7px 0 0;
}

.problems-table td {
  padding: 17px 18px;
  border-bottom: 1px solid #252e3e;
  color: #cbd5e1;
  font-size: 13px;
  vertical-align: middle;
}

.problems-table tbody tr {
  transition: background 0.18s ease;
}

.problems-table tbody tr:hover {
  background: #192131;
}

.problems-table tbody tr:last-child td {
  border-bottom: 0;
}

.status-column {
  width: 65px;
  text-align: center !important;
}

.action-column {
  width: 70px;
  text-align: center !important;
}

.solved-icon {
  color: #4ade80;
  vertical-align: middle;
}

.unsolved-icon {
  color: #64748b;
  vertical-align: middle;
}

.problem-title-link {
  display: inline-block;
  color: #e2e8f0;
  font-size: 13px;
  font-weight: 650;
  white-space: normal;
  text-decoration: none;
}

.problem-title-link > span {
  margin-right: 5px;
  color: #78869c;
  font-weight: 500;
}

.problem-title-link:hover {
  color: #a5b4fc;
}

/* Topic labels */

.table-topics {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 8px;
}

.topic-tag {
  padding: 4px 7px;
  border: 1px solid #30394b;
  border-radius: 5px;
  background: #202939;
  color: #aebbd0;
  font-size: 10px;
  cursor: pointer;
  transition: 0.2s ease;
}

.topic-tag:hover {
  border-color: #818cf8;
  background: #29274d;
  color: #c7d2fe;
}

/* Difficulty labels */

.difficulty {
  display: inline-block;
  padding: 5px 9px;
  border-radius: 6px;
  font-size: 11px;
  font-weight: 650;
}

.difficulty-easy {
  background: #153426;
  color: #4ade80;
}

.difficulty-medium {
  background: #392e19;
  color: #fbbf24;
}

.difficulty-hard {
  background: #3b2029;
  color: #fb7185;
}

.acceptance-cell {
  color: #aab4c5 !important;
  font-variant-numeric: tabular-nums;
}

.open-problem {
  display: inline-grid;
  place-items: center;
  width: 32px;
  height: 32px;
  border: 1px solid #30394b;
  border-radius: 8px;
  background: #171e2b;
  color: #aab4c5;
  text-decoration: none;
  transition: 0.2s ease;
}

.open-problem:hover {
  transform: translateY(-1px);
  border-color: #818cf8;
  background: #29274d;
  color: #c7d2fe;
}

/* Empty search results */

.empty-problems {
  display: flex;
  align-items: center;
  flex-direction: column;
  gap: 10px;
  padding: 44px 20px;
  color: #8491a6;
  text-align: center;
}

.empty-problems h3 {
  margin: 0;
  color: #e2e8f0;
  font-size: 17px;
}

.empty-problems p {
  margin: 0 0 8px;
  font-size: 13px;
}

/* Footer */

.problems-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 15px 22px;
  border-top: 1px solid #293244;
  color: #8491a6;
  font-size: 11px;
}

.problems-footer span:last-child {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: #a5b4fc;
}

/* Problems page: responsive */

@media (max-width: 600px) {
  .problems-heading {
    align-items: flex-start;
    flex-direction: column;
  }

  .problems-heading h1 {
    font-size: 25px;
  }

  .problems-total {
    align-items: flex-start;
    width: 100%;
    padding: 10px;
  }

  .problems-total span {
    font-size: 9px;
  }

  .problem-stats {
    grid-template-columns: 1fr;
  }

  .problem-stat {
    padding: 13px 16px;
  }

  .problem-stat strong {
    font-size: 15px;
  }

  .problems-toolbar {
    align-items: stretch;
    flex-direction: column;
    padding: 16px 14px 12px;
  }

  .filter-button {
    align-self: flex-start;
  }

  .difficulty-filters {
    padding: 4px 14px 14px;
  }

  .table-summary {
    padding: 12px 14px;
  }

  .advanced-filters {
    padding: 14px;
  }

  .problems-footer {
    align-items: flex-start;
    flex-direction: column;
    padding: 14px;
  }
}

/* ========================================
   Problem workspace
======================================== */

/* Let the problem workspace use the full browser width */
.main-area.workspace-main-area {
  margin-left: 0;
}

.workspace-main-area > .workspace-page {
  width: 100%;
}

.workspace-page {
  height: 100vh;
  width: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #0b0d12;
  color: #e5e7eb;
}

.workspace-topbar {
  height: 58px;
  min-height: 58px;
  display: flex;
  align-items: center;
  gap: 20px;
  padding: 0 20px;
  background: #101119;
  border-bottom: 1px solid #272b38;
}

.back-to-problems,
.workspace-home-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: #c4b5fd;
  text-decoration: none;
}

.workspace-breadcrumb {
  display: flex;
  align-items: center;
  gap: 12px;
  flex: 1;
  min-width: 0;
}

.workspace-breadcrumb strong {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.workspace-top-actions,
.workspace-language-label {
  display: flex;
  align-items: center;
  gap: 12px;
}

.workspace-language-label {
  color: #a5b4fc;
}

.workspace-body {
  flex: 1;
  min-height: 0;
  display: grid;
  grid-template-columns: minmax(300px, 42%) minmax(0, 58%);
  gap: 8px;
  padding: 8px;
  overflow: hidden;
}

.description-pane,
.editor-pane {
  min-width: 0;
  min-height: 0;
  overflow: hidden;
  border: 1px solid #272b38;
  border-radius: 10px;
  background: #11141d;
}

.description-pane {
  display: flex;
  flex-direction: column;
}

.workspace-tabs,
.test-panel-tabs {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 16px;
  border-bottom: 1px solid #272b38;
}

.workspace-tabs button,
.test-panel-tabs button {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 8px 10px;
  color: #9ca3af;
  background: transparent;
  border: 0;
  border-radius: 6px;
  cursor: pointer;
}

.workspace-tabs button.active,
.test-panel-tabs button.active {
  color: #c4b5fd;
  background: #28213f;
}

.description-content {
  flex: 1;
  overflow-y: auto;
  padding: 20px;
}

.problem-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
}

.problem-title-row h1 {
  margin: 0;
  font-size: 23px;
  line-height: 1.4;
}

.workspace-problem-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14px;
  margin: 16px 0;
}

.workspace-meta-item {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: #9ca3af;
  font-size: 13px;
}

.description-text {
  color: #d1d5db;
  line-height: 1.8;
}

.section-label {
  margin: 24px 0 12px;
  font-size: 16px;
}

.example-card {
  margin: 12px 0;
  padding: 14px;
  border: 1px solid #2b3040;
  border-radius: 8px;
  background: #171b27;
}

.example-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 12px;
}

.example-heading button {
  color: #c4b5fd;
  background: transparent;
  border: 1px solid #38304f;
  border-radius: 5px;
  padding: 6px 9px;
  cursor: pointer;
}

.example-field {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin: 12px 0;
}

.example-field code,
.constraints-list code {
  color: #cbd5e1;
  overflow-wrap: anywhere;
}

.example-explanation {
  color: #9ca3af;
  line-height: 1.6;
}

.constraints-list {
  display: grid;
  gap: 10px;
  padding-left: 20px;
}

.topic-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 24px;
}

.editor-pane {
  display: flex;
  flex-direction: column;
}

.editor-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  min-height: 48px;
  padding: 8px 14px;
  background: #151823;
  border-bottom: 1px solid #272b38;
}

.editor-toolbar-left,
.editor-toolbar-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.editor-file-icon {
  display: flex;
  color: #a5b4fc;
}

.editor-language-badge {
  padding: 4px 7px;
  color: #a5b4fc;
  background: #24283a;
  border-radius: 5px;
  font-size: 12px;
}

.editor-toolbar-actions button {
  padding: 5px;
  color: #aab1c2;
  background: transparent;
  border: 0;
  cursor: pointer;
}

.monaco-container {
  flex: 1;
  min-height: 160px;
  overflow: hidden;
}

.editor-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 10px 14px;
  background: #151823;
  border-top: 1px solid #272b38;
}

.editor-bottom-status,
.editor-bottom-actions {
  display: flex;
  align-items: center;
  gap: 14px;
}

.editor-bottom-status {
  color: #9ca3af;
  font-size: 12px;
}

.editor-bottom-status span {
  display: inline-flex;
  align-items: center;
  gap: 5px;
}

.editor-bottom-actions button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  padding: 8px 13px;
  border-radius: 6px;
  cursor: pointer;
}

.run-button {
  color: #fff;
  background: #15803d;
  border: 1px solid #16a34a;
}

.submit-button {
  color: #fff;
  background: #6d4bd1;
  border: 1px solid #8062e5;
}

.editor-bottom-actions button:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.test-panel {
  flex: 0 0 220px;
  min-height: 150px;
  overflow: auto;
  border-top: 1px solid #272b38;
  background: #11141d;
}

.test-cases-content,
.result-content {
  padding: 14px 16px;
}

.test-case-selector {
  display: flex;
  gap: 8px;
  margin-bottom: 16px;
}

.test-case-selector button {
  padding: 7px 11px;
  color: #9ca3af;
  background: #191d29;
  border: 1px solid #303648;
  border-radius: 6px;
  cursor: pointer;
}

.test-case-selector button.selected-test {
  color: #c4b5fd;
  border-color: #8b5cf6;
  background: #29213f;
}

.test-input-group {
  margin-top: 12px;
}

.test-input-group label {
  display: block;
  margin-bottom: 6px;
  color: #9ca3af;
  font-size: 12px;
}

.test-input-value {
  padding: 10px;
  color: #e5e7eb;
  background: #191d29;
  border: 1px solid #2b3040;
  border-radius: 6px;
  font-family: monospace;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.result-heading {
  display: flex;
  align-items: center;
  gap: 8px;
}

.result-content p,
.demo-result-note {
  color: #9ca3af;
  line-height: 1.6;
}

.result-placeholder,
.submissions-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 30px 16px;
  color: #9ca3af;
  text-align: center;
}

.workspace-not-found {
  padding: 40px;
  color: #e5e7eb;
  background: #0b0d12;
}

@media (max-width: 900px) {
  .workspace-page {
    height: auto;
    min-height: 100vh;
    overflow: visible;
  }

  .workspace-body {
    grid-template-columns: 1fr;
    overflow: visible;
  }

  .description-pane {
    min-height: 500px;
  }

  .editor-pane {
    min-height: 650px;
  }

  .monaco-container {
    min-height: 350px;
  }
}

@media (max-width: 600px) {
  .workspace-topbar {
    padding: 0 10px;
    gap: 10px;
  }

  .workspace-breadcrumb {
    font-size: 13px;
  }

  .workspace-home-link {
    display: none;
  }

  .description-content {
    padding: 14px;
  }

  .problem-title-row h1 {
    font-size: 20px;
  }

  .editor-toolbar {
    padding: 8px;
  }

  .editor-toolbar-left,
  .editor-toolbar-actions {
    gap: 7px;
  }

  .editor-bottom {
    align-items: flex-start;
    flex-direction: column;
  }

  .test-panel {
    flex-basis: 200px;
  }
}

/* CodeArena authentication pages */
.auth-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32px 16px;
  background: #f5f7fb;
}

.auth-card {
  width: 100%;
  max-width: 440px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 32px;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 18px;
  box-shadow: 0 12px 36px rgba(15, 23, 42, 0.08);
}

.auth-brand {
  color: #4f46e5;
  font-size: 22px;
  font-weight: 800;
  text-decoration: none;
  margin-bottom: 8px;
}

.auth-card h1 {
  margin: 0;
  color: #111827;
  font-size: 28px;
}

.auth-subtitle {
  margin: 0 0 12px;
  color: #6b7280;
  line-height: 1.5;
}

.auth-card label {
  color: #374151;
  font-size: 14px;
  font-weight: 600;
}

.auth-card input {
  width: 100%;
  box-sizing: border-box;
  padding: 12px 14px;
  border: 1px solid #d1d5db;
  border-radius: 9px;
  background: #fff;
  color: #111827;
  font: inherit;
  outline: none;
}

.auth-card input:focus {
  border-color: #6366f1;
  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.14);
}

.auth-submit {
  margin-top: 10px;
  padding: 13px 16px;
  border: none;
  border-radius: 9px;
  background: #4f46e5;
  color: #fff;
  font-size: 15px;
  font-weight: 700;
  cursor: pointer;
}

.auth-submit:hover {
  background: #4338ca;
}

.auth-submit:disabled {
  cursor: not-allowed;
  opacity: 0.65;
}

.auth-error {
  padding: 11px 12px;
  border: 1px solid #fecaca;
  border-radius: 8px;
  background: #fef2f2;
  color: #b91c1c;
  font-size: 14px;
}

.auth-footer {
  margin: 12px 0 0;
  text-align: center;
  color: #6b7280;
  font-size: 14px;
}

.auth-footer a {
  color: #4f46e5;
  font-weight: 700;
  text-decoration: none;
}

.auth-footer a:hover {
  text-decoration: underline;
}

@media (max-width: 480px) {
  .auth-card {
    padding: 24px 20px;
  }

  .auth-card h1 {
    font-size: 24px;
  }
}
.execution-output,
.execution-error {
  margin-top: 8px;
  padding: 12px;
  border-radius: 6px;
  background: #111827;
  color: #e5e7eb;
  font-family: monospace;
  font-size: 13px;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  overflow-x: auto;
}

.execution-error {
  color: #fca5a5;
}

.execution-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-top: 12px;
  font-size: 12px;
  color: #9ca3af;
}

.execution-stats span {
  display: inline-flex;
  align-items: center;
  gap: 6px;
}